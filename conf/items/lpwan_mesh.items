// Практична робота 3.2 — items для LoRaWAN / Zigbee / аналітики
Group gLPWAN "LPWAN Networks"
Group gLoRaWAN "LoRaWAN Network" (gLPWAN)
Group gLoRaInfrastructure "LoRaWAN Infrastructure" (gLoRaWAN)
Group gMesh "Mesh Networks"
Group gZigbee "Zigbee Mesh Network" (gMesh)
Group gZigbeeCoordinator "Zigbee Coordinator" (gZigbee)
Group gZigbeeRouters "Zigbee Routers" (gZigbee)
Group gZigbeeEndDevices "Zigbee End Devices" (gZigbee)
Group gProtocolComparison "Protocol Comparison"
Group gComparison "Protocol Analysis" (gProtocolComparison)
Group gSystemControl "System Control"

Switch EmulationActive "Emulation Active" (gSystemControl) {autoupdate="true"}
String SystemCommand "System Command" (gSystemControl)
String ProtocolTest "Protocol Test" (gSystemControl)

String GatewayStatus "Gateway Status [%s]" (gLoRaInfrastructure)
Number PacketsReceived "Packets Received [%.0f]" (gLoRaInfrastructure)
Number PacketsLost "Packets Lost [%.0f]" (gLoRaInfrastructure)
Number GatewayRssi "Gateway RSSI [%.0f dBm]" (gLoRaInfrastructure)
String NetworkStatus "Network Server [%s]" (gLoRaInfrastructure)
Number ActiveDevices "Active LoRa Devices [%.0f]" (gLoRaInfrastructure)
String LoRaPackets "Last LoRa Packet [%s]" (gLoRaInfrastructure)
Number GatewayLoad "Gateway Load [%.1f %%]" (gLoRaInfrastructure)
Number GatewayTemperature "Gateway Temperature [%.1f °C]" (gLoRaInfrastructure)
Number DutyCycleUsed "Simulated Duty Cycle [%.3f %%]" (gLoRaInfrastructure)
String AdrStatus "ADR Status [%s]" (gLoRaInfrastructure)
String ApplicationData "Application Server Data [%s]" (gLoRaInfrastructure)

Group gLoraSF7 "LoRa SF7 Device (2 km)" (gLoRaWAN)
Number LoraSF7Temperature "SF7 Temperature [%.1f °C]" (gLoraSF7)
